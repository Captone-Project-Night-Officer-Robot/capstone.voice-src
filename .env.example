# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Night Officer Voice Agent"
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ─── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=120
GROQ_TEMPERATURE=0.3

# ─── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVEN_TTS_MODEL=eleven_multilingual_v2
ELEVEN_VOICE_ID=your_elevenlabs_voice_id
ELEVEN_STT_MODEL=scribe_v2_realtime
ELEVEN_STT_LANGUAGE=en

# ─── Agent tuning ─────────────────────────────────────────────────────────────
AGENT_MIN_ENDPOINTING_DELAY=1.2
AGENT_MAX_ENDPOINTING_DELAY=8.0
AGENT_ALLOW_INTERRUPTIONS=true

# ─── VAD tuning ───────────────────────────────────────────────────────────────
VAD_ACTIVATION_THRESHOLD=0.6
VAD_MIN_SILENCE_DURATION=0.3
VAD_MIN_SPEECH_DURATION=0.1

# ─── Twilio (emergency SMS dispatch) ─────────────────────────────────────────
# When all four are filled in, the agent texts the collected patient info to
# EMERGENCY_PHONE_NUMBER at Step 6 of the screening flow. Leave any blank to
# disable (agent still completes the conversation, just logs the payload).
# Rotate the auth token in the Twilio console if it has ever been exposed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_PHONE_NUMBER=